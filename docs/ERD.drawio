e file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#BBBBBB;fontColor=#E0E0E0;labelBackgroundColor=#1E1E1E;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToOne;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="media_0" target="img_2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="profile pic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#BBBBBB;fontColor=#E0E0E0;labelBackgroundColor=#1E1E1E;fontSize=11;startArrow=ERzeroToOne;endArrow=ERzeroToOne;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="media_0" target="user_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="resets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#BBBBBB;fontColor=#E0E0E0;labelBackgroundColor=#1E1E1E;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="user_0" target="prt_1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="28" y="103"/><mxPoint x="28" y="509"/></Array></mxGeometry></mxCell><mxCell id="e8" value="uploaded by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#BBBBBB;fontColor=#E0E0E0;labelBackgroundColor=#1E1E1E;fontSize=11;startArrow=ERmandOne;endArrow=ERzeroToMany;exitX=0;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="user_0" target="media_6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="14" y="103"/><mxPoint x="14" y="630"/><mxPoint x="390" y="630"/><mxPoint x="390" y="525"/></Array></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Constraints &amp;amp; rules&lt;/b&gt;&lt;br&gt;• UNIQUE INDEX on Loan(copy_id) WHERE returned_at IS NULL → one active loan per copy&lt;br&gt;• Book availability is &lt;i&gt;derived&lt;/i&gt;: copies − active loans (no stored flag)&lt;br&gt;• Loan FKs use ON DELETE RESTRICT to keep history (deactivate users instead)&lt;br&gt;• BookImage: PK (book_id, position); position 0 is the cover; media_id UNIQUE so an image belongs to one book; ON DELETE CASCADE from Book (S3 files cleaned up separately)&lt;br&gt;• MediaAsset is shared by book images and user avatars&lt;br&gt;• MediaAsset.storage_key is immutable: a new image gets a new key, so the CDN caches forever&lt;br&gt;• PasswordResetToken stores only the sha256 hash; expires_at + used_at make it short-lived and single-use&lt;br&gt;• Session table is created by the session-store package (stores userId, role)&lt;br&gt;&lt;br&gt;&lt;b&gt;schema.sql order&lt;/b&gt;&lt;br&gt;Create: User → MediaAsset → Book → BookImage → BookCopy → Loan → PasswordResetToken&lt;br&gt;Drop: reverse order. User ↔ MediaAsset reference each other, so turn foreign keys off while dropping." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#2E2A14;strokeColor=#B09500;fontColor=#E0E0E0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="60" width="380" height="400" as="geometry"/></mxCell><mxCell id="title" value="Shelvus – Entity Relationship Diagram" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#FFFFFF;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
